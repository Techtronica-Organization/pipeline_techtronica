################################################################################
# Pipeline telemetria — monitoring_service/.env
# Copie este arquivo para .env nesta pasta. Front NÃO usa estas vars.
#
# DevOps: alinhar com techtronica_web_backend/backend/.env:
#   PIPELINE_INTERNAL_TOKEN  ==  PIPELINE_INTERNAL_TOKEN (backend)
#   TELEMETRY_WEBHOOK_SECRET ==  TELEMETRY_WEBHOOK_SECRET (backend)
#   BACKEND_API_BASE_URL     ==  URL alcançável da API (ex. host.docker.internal:8000)
################################################################################

# [front/devops] Porta no HOST da serving API (docs em http://localhost:8100/docs)
PIPELINE_API_PORT=8100

# [obrigatório] Token das rotas /internal/* (ativar telemetria). Igual ao backend.
PIPELINE_INTERNAL_TOKEN=dev-pipeline-internal-token

# [obrigatório] Segredo do prediction_worker → webhook do backend. Igual ao backend.
TELEMETRY_WEBHOOK_SECRET=dev-telemetry-webhook-secret

# [obrigatório] Base da API Techtrônica (sem path). Worker posta em
#   {BACKEND_API_BASE_URL}/api/v1/internal/webhooks/telemetry-prediction-result
BACKEND_API_BASE_URL=http://host.docker.internal:8000
# BACKEND_HTTP_TIMEOUT_SEC=30

# [opcional] Tuning do prediction_worker
PREDICTION_POLL_INTERVAL_SEC=10
PREDICTION_BATCH_SIZE=20
PREDICTION_LEASE_SECONDS=120
PREDICTION_MAX_ATTEMPTS=5

# Simulação: segundos reais = 1 hora simulada
#   60   = default (compose/config) — demo local
#   5    = teste acelerado
#   3600 = tempo real (1h simulada ≈ 1h real)
SIMULATION_INTERVAL_SEC=60.0
NUM_HOSPITALS=10
