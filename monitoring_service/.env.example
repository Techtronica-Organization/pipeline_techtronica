# Copie para monitoring_service/.env e ajuste se necessário.
# docker compose lê este arquivo automaticamente quando presente nesta pasta.
# Valores default também estão no docker-compose.yml (${VAR:-default}).

# Porta publicada da serving API (host → container 8000)
PIPELINE_API_PORT=8100

# Auth da serving API (ativar telemetria). MESMO valor no backend: PIPELINE_INTERNAL_TOKEN
PIPELINE_INTERNAL_TOKEN=dev-pipeline-internal-token

# Webhook do prediction_worker → backend. MESMO valor no backend: TELEMETRY_WEBHOOK_SECRET
TELEMETRY_WEBHOOK_SECRET=dev-telemetry-webhook-secret

# Base da API Techtrônica (sem path). Em Docker no Windows/Mac use host.docker.internal
BACKEND_API_BASE_URL=http://host.docker.internal:8000
# BACKEND_HTTP_TIMEOUT_SEC=30

# Prediction worker
PREDICTION_POLL_INTERVAL_SEC=10
PREDICTION_BATCH_SIZE=20
PREDICTION_LEASE_SECONDS=120
PREDICTION_MAX_ATTEMPTS=5

# Simulação (também pode ir no environment do compose)
# SIMULATION_INTERVAL_SEC=5
# NUM_HOSPITALS=10
