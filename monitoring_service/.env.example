################################################################################
# Pipeline telemetria — monitoring_service/.env
# Copie para .env nesta pasta.
#
# Dev: defaults abaixo ok.
# Prod: PIPELINE_ENV=prod + secrets fortes (>=16 chars, sem "dev-"/"strongpassword").
#       Alinhar tokens com techtronica_web_backend/backend/.env
################################################################################

PIPELINE_ENV=dev

PIPELINE_API_PORT=8100
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword123
POSTGRES_DB=serving_db

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=strongpassword123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mesmo valor no backend
PIPELINE_INTERNAL_TOKEN=dev-pipeline-internal-token
TELEMETRY_WEBHOOK_SECRET=dev-telemetry-webhook-secret
BACKEND_API_BASE_URL=http://host.docker.internal:8000

PREDICTION_POLL_INTERVAL_SEC=10
PREDICTION_BATCH_SIZE=20
PREDICTION_LEASE_SECONDS=120
PREDICTION_MAX_ATTEMPTS=5

# Segundos reais = 1h simulada: 60 demo | 5 teste | 3600 tempo real
SIMULATION_INTERVAL_SEC=60.0
NUM_HOSPITALS=10

# Mock API externa (integração backend) — porta 8200
EXTERNAL_DATA_API_PORT=8200
EXTERNAL_API_KEY=dev-external-api-key
EXTERNAL_API_SECRET=dev-external-api-secret
EXTERNAL_JWT_SECRET=dev-external-jwt-secret
